# 域名与证书邮箱（首次部署必须填写）
VC_DOMAIN=vc.example.com
VC_EMAIL=ops@example.com

# 基础环境
TZ=Asia/Shanghai
VITE_API_BASE=/api

# 后端令牌（建议在 VPS 生成强随机值）
API_TOKEN=change-me

# 数据库（当前后端默认 SQLite；Postgres 仅预留扩展位）
POSTGRES_DB=vectorcontrol
POSTGRES_USER=vectorcontrol
POSTGRES_PASSWORD=change-me
DATABASE_URL=

# CORS（生产建议为空并使用同域 /api）
CORS_ORIGINS=
