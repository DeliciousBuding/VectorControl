# 域名与证书邮箱
VC_DOMAIN=vc.example.com
VC_EMAIL=ops@example.com

# 部署模式
# true: 启用 HTTPS（Certbot + Let's Encrypt）
# false: HTTP 最小闭环（本地/预演）
VC_ENABLE_TLS=true

# 验收脚本访问协议，通常由 deploy_prod.sh 自动覆盖
VC_SCHEME=https

# 基础环境
TZ=Asia/Shanghai
VITE_API_BASE=/api

# 后端访问令牌（生产请使用高强度随机值）
API_TOKEN=change-me

# Postgres 参数
POSTGRES_DB=vectorcontrol
POSTGRES_USER=vectorcontrol
POSTGRES_PASSWORD=change-me
DATABASE_URL=

# CORS（同域 /api 可留空）
CORS_ORIGINS=
